<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#173c35">
  <title>Quản lý Sách</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="site-body">
  <div class="site-shell">
    <header class="site-header">
      <a class="brand" href="/" aria-label="Bookspace - Trang chủ">
        <span class="brand-mark" aria-hidden="true">B</span>
        <span class="brand-text"><strong>Bookspace</strong><small>Thư viện số</small></span>
      </a>
      <span class="header-tag">Quản lý Sách</span>
    </header>
    <main class="page-content">{{{body}}}</main>
    <footer class="site-footer">
      <span>Đồ án Quản lý Sách</span>
      <span>Họ tên: {{studentName}} · MSSV: {{studentId}} · VAT: {{vatRate}}%</span>
    </footer>
  </div>
